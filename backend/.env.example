# ── OCR Configuration ──
OCR_MODEL=glm-ocr
OCR_API_KEY=sk-xxx # Use local Ollama models when set to "ollama"; otherwise use remote models via API provider
OCR_BASE_URL=https://your-gateway.com/v1

# ── Embedding Configuration ──
EMBEDDING_MODEL=nomic-embed-text-v2-moe
EMBEDDING_API_KEY=sk-xxx # Use local Ollama models when set to "ollama"; otherwise use remote models via API provider
EMBEDDING_BASE_URL=https://your-gateway.com/v1

# ── LLM Configuration ──
LLM_MODEL=llama3.2
LLM_API_KEY=sk-xxx # Use local Ollama models when set to "ollama"; otherwise use remote models via API provider
LLM_BASE_URL=https://your-gateway.com/v1

# ── Neo4j Configuration ──
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=pdf-rag-analyzer

# ── Milvus Configuration ──
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ── RAG Parameters ──
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50
# TOP_K=5
# EMBEDDING_DIMENSION=768

# ── Backend Application ──
# APP_HOST=0.0.0.0
# APP_PORT=8000
# LOG_LEVEL=INFO

# ── File Upload ──
# Maximum upload file size in bytes (default: 52428800 = 50MB)
# MAX_FILE_SIZE=52428800