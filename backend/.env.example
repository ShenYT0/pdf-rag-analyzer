# ══════════════════════════════════════════════════════════════
# PDF RAG Analyzer - Backend Environment Configuration
#
# Usage:
#   1. Copy this file:  cp .env.example .env
#   2. Edit .env with your configuration
#   3. Start with Docker: docker compose up --build
# ══════════════════════════════════════════════════════════════

# ── OCR Configuration ──
OCR_MODEL=glm-ocr
OCR_API_KEY=ollama              # "ollama" = local Ollama; otherwise remote API key (e.g. "sk-xxx")
OCR_BASE_URL=http://localhost:11434/v1

# ── Embedding Configuration ──
EMBEDDING_MODEL=nomic-embed-text-v2-moe
EMBEDDING_API_KEY=ollama        # "ollama" = local Ollama; otherwise remote API key
EMBEDDING_BASE_URL=http://localhost:11434/v1

# ── LLM Configuration ──
LLM_MODEL=llama3.2
LLM_API_KEY=ollama              # "ollama" = local Ollama; otherwise remote API key
LLM_BASE_URL=http://localhost:11434/v1

# ── Neo4j Configuration ──
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=pdf-rag-analyzer

# ── Milvus Configuration ──
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ── RAG Parameters ──
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50
# TOP_K=5
# EMBEDDING_DIMENSION=768

# ── Backend Application ──
# APP_HOST=0.0.0.0
# APP_PORT=8000
# LOG_LEVEL=INFO

# ── File Upload ──
# Maximum upload file size in bytes (default: 52428800 = 50MB)
# MAX_FILE_SIZE=52428800


# ══════════════════════════════════════════════════════════════
# Docker Mode Guide
# ══════════════════════════════════════════════════════════════
#
# When running via `docker compose`, the following values are
# automatically overridden by docker-compose.yml:
#
#   NEO4J_URI    → bolt://neo4j:7687
#   MILVUS_HOST  → milvus
#   MILVUS_PORT  → 19530
#
# You only need to configure the LLM/OCR/Embedding settings:
#
# ── Option A: Local Ollama ──
#   Ensure Ollama is running on the host, then set:
#     API_KEY=ollama
#     BASE_URL=http://host.docker.internal:11434/v1
#
# ── Option B: Remote API (OpenAI-compatible) ──
#   Set your API key and remote endpoint:
#     API_KEY=sk-your-api-key
#     BASE_URL=https://api.openai.com/v1
#     LLM_MODEL=gpt-4o            (or your model name)
#     EMBEDDING_MODEL=text-embedding-3-small
#     OCR_MODEL=gpt-4o            (or your multimodal model)
#
# Then restart: docker compose up -d
# ══════════════════════════════════════════════════════════════